{
  "name": "@ghostwriter/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:test-keys": "tsx --env-file=.env scripts/check-test-keys.ts",
    "prebuild": "npm run build --prefix ../../packages/scoring",
    "pretest": "npm run build --prefix ../../packages/scoring",
    "pretypecheck": "npm run build --prefix ../../packages/scoring",
    "predev": "npm run build --prefix ../../packages/scoring"
  },
  "dependencies": {
    "@ghostwriter/scoring": "^0.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}